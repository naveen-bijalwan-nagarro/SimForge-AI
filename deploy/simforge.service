[Unit]
Description=SimForge-AI simulation service
After=network.target

[Service]
User=simforge
Group=simforge
WorkingDirectory=/opt/simforge/SimForge-AI
Environment=SIMFORGE_ENV=production
Environment=SIMFORGE_DATA_DIR=/var/lib/simforge
EnvironmentFile=/etc/simforge.env
ExecStart=/opt/simforge/SimForge-AI/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/simforge
UMask=0077

[Install]
WantedBy=multi-user.target
